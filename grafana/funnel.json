      "type": "bargauge",
      "title": "Воронка визита",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "database": "default",
          "table": "tarotalpha",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "table",
          "query": "SELECT count() AS visits, countIf(opened > 0) AS opened_a_day, countIf(wall > 0) AS hit_paywall, countIf(shared > 0) AS shared FROM ( SELECT blob3 AS visit, countIf(blob1 = 'step_opened') AS opened, countIf(blob1 = 'paywall_hit') AS wall, countIf(blob1 = 'shared') AS shared FROM tarotalpha WHERE $timeFilter GROUP BY visit)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Один визит считается один раз на каждом шаге."
    },
    {
