          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "table",
          "query": "SELECT quantileExactWeighted(0.5)(days, 1) AS median FROM ( SELECT blob3 AS visit, countIf(blob1 = 'step_opened') AS days FROM tarotalpha WHERE $timeFilter GROUP BY visit)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
