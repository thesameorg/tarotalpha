      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "database": "default",
          "table": "tarotalpha",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "table",
          "query": "SELECT SUM(double6) / 100 AS revenue FROM tarotalpha WHERE $timeFilter AND blob1 = 'paid' AND double6 > 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Сумму ставит воркер по прайсу полки, а не браузер."
