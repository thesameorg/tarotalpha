      "title": "Путь к деньгам по дням",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "database": "default",
          "table": "tarotalpha",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "time_series",
          "query": "SELECT toUnixTimestamp(day) * 1000 AS t, countIf(shown > 0) AS paywall_shown, countIf(clicked > 0) AS buy_clicked, countIf(offered > 0) AS invoice_created, countIf(paid > 0) AS paid FROM ( SELECT blob3 AS visit, toStartOfDay(timestamp) AS day, countIf(blob1 = 'paywall_shown') AS shown, countIf(blob1 = 'buy_clicked') AS clicked, countIf(blob1 = 'invoice_created') AS offered, countIf(blob1 = 'paid') AS paid FROM tarotalpha WHERE $timeFilter GROUP BY visit, day) GROUP BY t ORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "Показали пейвол → выбрали пачку → выписали предложение → деньги дошли."
    },
