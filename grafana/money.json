      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "database": "default",
          "table": "tarotalpha",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "table",
          "query": "SELECT countIf(wall > 0 AND paid > 0) / countIf(wall > 0) AS conversion FROM ( SELECT blob3 AS visit, countIf(blob1 = 'paywall_hit') AS wall, countIf(blob1 = 'paid') AS paid FROM tarotalpha WHERE $timeFilter GROUP BY visit)"
        }
