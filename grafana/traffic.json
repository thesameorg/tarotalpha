    {
      "id": 5,
      "type": "timeseries",
      "title": "Время на сайте и доля отказов по дням",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ds}"
          },
          "database": "default",
          "table": "tarotalpha",
          "dateTimeType": "DATETIME",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "editorMode": "sql",
          "extrapolate": false,
          "skip_comments": true,
          "intervalFactor": 1,
          "format": "time_series",
          "query": "SELECT toUnixTimestamp(day) * 1000 AS t, quantileExactWeighted(0.5)(seconds, 1) AS median_seconds, countIf(opened = 0) / count() AS bounce FROM ( SELECT blob3 AS visit, toStartOfDay(timestamp) AS day, toUnixTimestamp(max(timestamp)) - toUnixTimestamp(min(timestamp)) AS seconds, countIf(blob1 = 'step_opened') AS opened FROM tarotalpha WHERE $timeFilter GROUP BY visit, day) GROUP BY t ORDER BY t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "Регрессия видна скачком на конкретный день, а не в среднем за неделю. Время — медиана по визитам, хартбитов нет."
