          "query": "SELECT quantileExactWeighted(0.5)(seconds, 1) AS median FROM ( SELECT blob3 AS visit, toUnixTimestamp(max(timestamp)) - toUnixTimestamp(min(timestamp)) AS seconds FROM tarotalpha WHERE $timeFilter GROUP BY visit)"
