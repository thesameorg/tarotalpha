{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarotalpha",
  // Two accounts are logged in; pin the one the owner named so a deploy can never land in the other.
  "account_id": "e023ec3576222c6a7b6cdf933de3d915",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-08",
  // Logs are for digging into one failure, not for counting: three days on the free plan. Business facts go to the
  // Analytics Engine dataset below, which keeps three months and answers SQL (docs/analytics.md).
  "observability": { "enabled": true },
  // The funnel journal: one data point per event, written by the Worker, read by SQL over HTTP. It has its own
  // daily budget, so a viral day cannot cost a reading its D1 write. Blob layout: docs/analytics.md.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "tarotalpha" }],
  // The only writer no request asks for: it scores readings whose horizon has closed. Every ten minutes because a
  // run must stay inside 10 ms of CPU and therefore takes few readings at a time; the stars still follow the day.
  "triggers": { "crons": ["*/10 * * * *"] },
  // No `directory`: the Vite plugin fills it in at build time. SPA fallback keeps `/r/<id>` links on index.html.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the asset layer answers `/r/<id>` and `/s/<id>` with index.html itself and the Worker never
    // writes the meta tags.
    "run_worker_first": ["/api/*", "/r/*", "/s/*"],
  },
  // Workers Rate Limiting binding: 60 calls a minute per key (the client address), counted per Cloudflare location.
  // `namespace_id` is any integer unique inside the account; nothing has to be created remotely.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarotalpha",
      "database_id": "3f11b5d1-4b11-4d59-9538-47525d47e26e",
      "migrations_dir": "migrations",
    },
  ],
}
