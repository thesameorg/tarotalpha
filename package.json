{
  "name": "tarotalpha",
  "private": true,
  "scripts": {
    "wt": "./scripts/worktree.sh create",
    "wt:rm": "./scripts/worktree.sh rm",
    "check": "python3 scripts/docs_lint.py --base origin/main",
    "check:all": "python3 scripts/docs_lint.py",
    "related": "python3 scripts/docs_lint.py --base origin/main --related",
    "test:lint": "python3 scripts/test_docs_lint.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy --config web/dist/tarotalpha/wrangler.json",
    "deploy:tg": "pnpm run build && wrangler versions upload --preview-alias tg --config web/dist/tarotalpha/wrangler.json",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write .",
    "types": "wrangler types --include-runtime=false --strict-vars=false"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^9.39.5",
    "@twa-dev/types": "8.0.2",
    "@types/node": "^22.20.2",
    "cryptocurrency-icons": "^0.18.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "simple-icons": "^16.30.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1"
  },
  "packageManager": "pnpm@12.3.4"
}
